 Copy this file to .env and fill in real values before running the app.

# Required: Groq API key used by the AI Tutor, Quiz generation/grading,
# concept extraction, and Recommendation engine.
# Groq gives free API access (no credit card needed) to fast open models.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model used for all AI features. llama-3.3-70b-versatile is Groq's free,
# high-quality general-purpose model. See https://console.groq.com/docs/models
# for other free options (e.g. llama-3.1-8b-instant for lower latency).
GROQ_MODEL=llama-3.3-70b-versatile

# Groq's OpenAI-compatible endpoint - no need to change this.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Secret used to sign JWT auth tokens. Use a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string

# SQLite database file (relative to backend/ when running uvicorn from there)
DATABASE_URL=sqlite:///./study_companion.db

# Where uploaded PDFs are stored on disk
UPLOAD_DIR=./uploads

# Minutes before an access token expires
ACCESS_TOKEN_EXPIRE_MINUTES=1440
